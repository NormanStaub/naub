# SKiDL generated artifacts — regenerate with: python naub_v2.py
naub_v2.net
*_sklib.py
*.erc
*.log
skidl_REPL.*

# KiCad local / temporary files (not design source)
*.lck
*.kicad_prl
.history/

# Freerouting export/scratch (regenerate from the board)
*.dsn

# Fab output — regenerate with: python pcb/export_fab.py
# 3D output too (export/3d/) — regenerate with: python pcb/export_3d.py
export/

# Component 3D models — tens of MB of transformed vendor STEP, same policy as
# CAD/ at the repo root. Regenerate with: python pcb/make_3d_models.py
naub.3dshapes/
