(footprint "RotaryEncoder_Bourns_PEC11L-4xxxF-Sxxxx_Vertical"
  (version 20221018)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "Bourns PEC11L 11mm low-profile rotary encoder, vertical shaft, with push switch (-Sxxxx). Drawn from the rear-view PCB layout in https://www.bourns.com/docs/Product-Datasheets/PEC11L.pdf (REV. 04/26): terminals A/C/B on 2.5mm pitch, switch row 14.5mm away (7.5 + 7.0 across the mounting-tab line), 1.0mm pin holes, 2.1x1.4mm tab slots on 12.8mm span. Orientation convention matches KiCad's RotaryEncoder_Bourns_Vertical_PEC12R (S1 in line with A, S2 with B). NOTE: Bourns rates this part for wave soldering; hand soldering is officially 'not recommended' - use a fine tip, work fast.")
  (tags "rotary encoder switch Bourns PEC11L low profile")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -9.6) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "PEC11L" (at 0 9.8) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "${REFERENCE}" (at 0 0 90) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -6.11 -6.11) (end 6.11 -6.11) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -6.11 6.11) (end 6.11 6.11) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -6.11 -6.11) (end -6.11 -1.9) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -6.11 1.9) (end -6.11 6.11) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start 6.11 -6.11) (end 6.11 -1.9) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start 6.11 1.9) (end 6.11 6.11) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_circle (center -2.5 8.9) (end -2.3 8.9) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_rect (start -5.9 -6) (end 5.9 6) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_circle (center 0 0) (end 3.5 0) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -7.95 -8.55) (end 7.95 8.55) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (pad "A" thru_hole roundrect (at -2.5 7.5) (size 1.6 1.6) (drill 1.1) (layers "*.Cu" "*.Mask") (roundrect_rratio 0.25))
  (pad "C" thru_hole circle (at 0 7.5) (size 1.6 1.6) (drill 1.1) (layers "*.Cu" "*.Mask"))
  (pad "B" thru_hole circle (at 2.5 7.5) (size 1.6 1.6) (drill 1.1) (layers "*.Cu" "*.Mask"))
  (pad "S1" thru_hole circle (at -2.5 -7) (size 1.6 1.6) (drill 1.1) (layers "*.Cu" "*.Mask"))
  (pad "S2" thru_hole circle (at 2.5 -7) (size 1.6 1.6) (drill 1.1) (layers "*.Cu" "*.Mask"))
  (pad "SH" thru_hole oval (at -6.4 0) (size 2.6 3.2) (drill oval 1.5 2.2) (layers "*.Cu" "*.Mask"))
  (pad "SH" thru_hole oval (at 6.4 0) (size 2.6 3.2) (drill oval 1.5 2.2) (layers "*.Cu" "*.Mask"))
  (model "${KIPRJMOD}/naub.3dshapes/RotaryEncoder_Bourns_PEC11L-4020F-S0020.step"
    (offset (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
