(footprint "Waveshare_RP2350-Tiny_Hybrid"
  (version 20221018)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "Waveshare RP2350-Tiny (18x23.5mm) solder-down carrier footprint, hybrid mount, all 36 contacts hand-solderable. Module sits component-side up, FPC/USB edge at top (-y). Per contact of the 23-pad edge ring: 1.0mm plated hole under the module's own 0.75mm hole (header-pin alignment jig / top solder-through) + castellation finger pad extending 1.2mm past the module outline for iron fillets. 13 back pads (GND+GP16-19 / 3V3+GP23-20 columns at x=+/-5.4, SWD DIO/GND/CLK row 1.08mm below the FPC edge) get 1.0mm solder-through holes, soldered from the carrier underside. Geometry from Waveshare STEP+DXF+schematic+product photos 2026-07; SWD row position is photo-measured (+/-0.15mm) because the official DXF places it mid-board, contradicting the shipping product -- verify against the physical module with a 1:1 print before fab. GP16 is consumed by the module's onboard WS2812; GP24/25 exist only as NC mode-select pads (not on this footprint). GP27/28/29 have 47R series resistors on-module. Prefer ENIG.")
  (tags "Waveshare RP2350-Tiny RP2350A castellated solder-through carrier module")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -13.6) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "RP2350-Tiny" (at 0 14.2) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "${REFERENCE}" (at 0 0) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "FPC/USB edge" (at 0 -12.45) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_text user "GP0" (at 10.2 -12.0) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_rect (start -9 -11.75) (end 9 11.75) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_line (start -9.1 -11.85) (end 9.1 -11.85) (stroke (width 0.3) (type solid)) (layer "F.SilkS"))
