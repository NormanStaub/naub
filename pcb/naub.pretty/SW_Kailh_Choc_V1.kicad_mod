(footprint "SW_Kailh_Choc_V1"
  (version 20221018)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "Kailh Choc V1 (CPG1350) low-profile keyswitch, direct PCB solder mount. Geometry per the Kailh PG1350 drawing: contacts at (0,-5.9) and (5,-3.8) with 1.2mm holes, 3.45mm center stem, 1.9mm locating bosses at +/-5.5mm; 15x15mm body. Same pad geometry as the community kiswitch/keyswitch-kicad-library footprint.")
  (tags "keyswitch Kailh Choc V1 PG1350 low profile")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -8.8) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "Choc_V1" (at 0 8.8) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "${REFERENCE}" (at 0 3.5) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_rect (start -7.61 -7.61) (end 7.61 7.61) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_rect (start -7.5 -7.5) (end 7.5 7.5) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -7.75 -7.75) (end 7.75 7.75) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (pad "1" thru_hole circle (at 0 -5.9) (size 2.2 2.2) (drill 1.2) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 5 -3.8) (size 2.2 2.2) (drill 1.2) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 0 0) (size 3.45 3.45) (drill 3.45) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -5.5 0) (size 1.9 1.9) (drill 1.9) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 5.5 0) (size 1.9 1.9) (drill 1.9) (layers "*.Cu" "*.Mask"))
  (model "${KIPRJMOD}/naub.3dshapes/SW_Kailh_Choc_V1.step"
    (offset (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
