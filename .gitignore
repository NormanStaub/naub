# Local Claude Code config / session data
.claude/

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# CAD working files (mesh/step/blend/renders) — too large for git.
# Exception: DXF layout drawings are small and drive the PCB outline, so track them.
CAD/**
!CAD/**/
!CAD/**/*.dxf

# Python (host helper)
__pycache__/
*.py[cod]
.venv/
venv/

# User's local host config (copied from config.example.json)
host/config.json

# Sticky channel selections (per-machine runtime state)
host/naub_state.json

# host debug logs
host/*.log

# Rust daemon (naubd) build output + local config/state
naubd/target/
naubd/config.json
naubd/naub_state.json
naubd/*.log

# Generated previews from the V2 display tools (regenerate with host/gen_*.py)
firmware/v2/host/*_preview.png

# SKiDL artifacts dropped at the repo root when naub_v2.py is run from here
# instead of pcb/ — regenerate with: python pcb/naub_v2.py  (see pcb/.gitignore)
/naub_v2.net
/naub_v2.erc
/naub_v2.log
/naub_v2_sklib.py

# Empty KiCad project shell left over from the pre-rename "naub" board;
# the live design is pcb/naub_kicad.*
pcb/naub.kicad_pcb
pcb/naub.kicad_pro
pcb/naub.kicad_sch
pcb/naub/

# Unpacked from the repo-root c_c_red_alert_inet.zip by hand (see firmware/v2/README.md)
firmware/v2/host/font_src/

# device console captures (bench/diag/conlog.py)
bench/diag/*.log
bench/diag/*.stdout
